# Documented input sample. The real lab.auto.tfvars is gitignored (*.tfvars) — copy
# this file, drop the .example suffix, and fill in the placeholders below.

subscription_id = "00000000-0000-0000-0000-000000000000"

alert_emails = [
  "platform-alerts@example.invalid",
]

# Object id of the break-glass account (see operators.tf's "Operator identities"
# comment and README.md). Retrieve with, while signed in as that account:
#   az ad signed-in-user show --query id -o tsv
break_glass_object_id = "00000000-0000-0000-0000-000000000000"
tenant_id = "00000000-0000-0000-0000-000000000000"
