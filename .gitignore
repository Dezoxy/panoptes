# Private working context. Never tracked.
.context/

# Python
__pycache__/
*.py[cod]
.venv/
.ruff_cache/
.mypy_cache/
.pytest_cache/
dist/
*.egg-info/
.coverage
htmlcov/

# Terraform
# .terraform.lock.hcl is deliberately tracked so provider versions are reproducible.
# *.auto.tfvars.example files are deliberately tracked as documented input samples.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
# Backend file written by iac/azure/bootstrap/bootstrap.sh: subscription-specific identifiers.
*.tfbackend
# Saved plans are local artefacts.
*.tfplan
crash.log
crash.*.log

# Node
node_modules/

# Structurizr / diagram output rendered in CI
docs/architecture/generated/
docs/architecture/workspace.json

# Secrets and local environment
.env
.env.*
!.env.example

# OS and editor
.DS_Store
.idea/
.vscode/
