# Copy to gateway/.env for a local `docker compose -f gateway/compose.yaml up` run
# (gateway/.env is gitignored and never committed). Every value below is empty: this
# file documents which keys the exit-path stack (ADR-0005) needs, it is never a source
# of secrets. Real values come from Key Vault — see gateway/README.md for the secret
# names — or, for local-only testing, a personal provider account.

# --- LiteLLM proxy ---
LITELLM_MASTER_KEY=
# Must match the POSTGRES_* values below, e.g.
# postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>
DATABASE_URL=

# --- Postgres (compose service only; the Container Apps add-on needs no credentials here) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Providers ---
AZURE_API_BASE=
AZURE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_API_BASE=

# --- JWT auth (Entra ID) ---
# https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
JWT_PUBLIC_KEY_URL=
# api://<tenant-id>/panoptes-gateway
JWT_AUDIENCE=

# --- OpenTelemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=
APPLICATIONINSIGHTS_CONNECTION_STRING=
